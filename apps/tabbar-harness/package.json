{
  "name": "@braisenly/tabbar-harness",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "prebuild": "pnpm --filter @braisenly/ui build",
    "predev": "pnpm --filter @braisenly/ui build",
    "build": "next build",
    "dev": "dotenv -e .env -- sh -c 'next dev --port \"$TABBAR_HARNESS_PORT\"'",
    "start": "dotenv -e .env -- sh -c 'next start --port \"$TABBAR_HARNESS_PORT\"'",
    "pretest:e2e": "pnpm --filter @braisenly/ui build",
    "test:e2e": "dotenv -e .env -- playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@braisenly/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "lucide-react": "^0.562.0",
    "motion": "^12.23.26",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^11.0.0",
    "tailwindcss": "4.3.2",
    "typescript": "~5.9.3"
  }
}
