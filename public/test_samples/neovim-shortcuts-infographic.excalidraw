    },
    {
      "type": "text",
      "id": "window_text",
      "x": 704,
      "y": 212,
      "width": 512,
      "height": 476,
      "text": "Windows + Buffers + Lists\\n\\nWindows\\n- ⌃h / ⌃j / ⌃k / ⌃l -> move between windows\\n- ⌃↑ / ⌃↓ / ⌃← / ⌃→ -> resize window\\n\\nBuffers\\n- ⇧h / ⇧l -> previous / next buffer\\n- ␠bd -> delete buffer\\n- ⌃s -> save file\\n- ␠qq -> quit all\\n- ␠ev -> edit init.lua\\n\\nQuickfix / location\\n- ]q / [q -> next / prev quickfix\\n- ]l / [l -> next / prev location item\\n\\nDiagnostics popup\\n- ␠cd -> line diagnostics float\\n\\nAutomatic support\\n- which-key.nvim -> key group discovery\\n- mini.pairs -> autopairs on insert\\n- mini.surround -> surround operators\\n- ts-comments.nvim -> JSX / TSX comment logic",
      "fontSize": 18,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "window_box",
      "originalText": "Windows + Buffers + Lists\\n\\nWindows\\n- ⌃h / ⌃j / ⌃k / ⌃l -> move between windows\\n- ⌃↑ / ⌃↓ / ⌃← / ⌃→ -> resize window\\n\\nBuffers\\n- ⇧h / ⇧l -> previous / next buffer\\n- ␠bd -> delete buffer\\n- ⌃s -> save file\\n- ␠qq -> quit all\\n- ␠ev -> edit init.lua\\n\\nQuickfix / location\\n- ]q / [q -> next / prev quickfix\\n- ]l / [l -> next / prev location item\\n\\nDiagnostics popup\\n- ␠cd -> line diagnostics float\\n\\nAutomatic support\\n- which-key.nvim -> key group discovery\\n- mini.pairs -> autopairs on insert\\n- mini.surround -> surround operators\\n- ts-comments.nvim -> JSX / TSX comment logic",
      "autoResize": true
    },
    {
      "type": "rectangle",
      "id": "snacks_box",
      "x": 1280,
      "y": 190,
      "width": 660,
      "height": 520,
