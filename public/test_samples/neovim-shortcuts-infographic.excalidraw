    {
      "type": "text",
      "id": "legend_text",
      "x": 1200,
      "y": 52,
      "width": 720,
      "height": 88,
      "text": "Legend\\n␠ = <leader>   ⌃ = Ctrl   ⌥ = Alt   ⇧ = Shift   Visual-only mappings are marked [V]\\nUse this sheet as: 1) core motions, 2) daily IDE keys, 3) AI / agent plugin command surface",
      "fontSize": 20,
