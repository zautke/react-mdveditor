      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "legend_box",
      "originalText": "Legend\\n␠ = <leader>   ⌃ = Ctrl   ⌥ = Alt   ⇧ = Shift   Visual-only mappings are marked [V]\\nUse this sheet as: 1) core motions, 2) daily IDE keys, 3) AI / agent plugin command surface",
      "autoResize": true
    },
    {
      "type": "rectangle",
      "id": "core_box",
      "x": 60,
      "y": 190,
      "width": 580,
      "height": 520,
      "roundness": { "type": 3 },
