    {
      "type": "text",
      "id": "core_text",
      "x": 84,
      "y": 212,
      "width": 532,
      "height": 476,
      "text": "Core Motions + Editing\\n\\nMove: h j k l | w b e ge | 0 ^ $\\nJump: gg G | % | f<char> F<char> t<char> T<char> | ; ,\\nSearch: * # /pattern n N\\nText objects: ciw diw viw ci( da{ yi\"\\nRepeat / undo: . u ⌃r\\n\\nConfig additions\\n- jk -> Esc\\n- ; -> :\\n- j / k -> visual lines gj / gk\\n- go / gO -> blank line below / above\\n- S -> split line at cursor\\n- ␠l -> toggle whitespace\\n- ␠v -> reselect pasted text\\n- ␠W -> strip trailing whitespace\\n- ␠z -> substitute word under cursor\\n- ␠n -> toggle line numbers\\n- [space] / ]space -> blank line above / below\\n- ⌥j / ⌥k -> move line or selection\\n- < / > [V] -> reindent and keep selection",
      "fontSize": 18,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "core_box",
      "originalText": "Core Motions + Editing\\n\\nMove: h j k l | w b e ge | 0 ^ $\\nJump: gg G | % | f<char> F<char> t<char> T<char> | ; ,\\nSearch: * # /pattern n N\\nText objects: ciw diw viw ci( da{ yi\"\\nRepeat / undo: . u ⌃r\\n\\nConfig additions\\n- jk -> Esc\\n- ; -> :\\n- j / k -> visual lines gj / gk\\n- go / gO -> blank line below / above\\n- S -> split line at cursor\\n- ␠l -> toggle whitespace\\n- ␠v -> reselect pasted text\\n- ␠W -> strip trailing whitespace\\n- ␠z -> substitute word under cursor\\n- ␠n -> toggle line numbers\\n- [space] / ]space -> blank line above / below\\n- ⌥j / ⌥k -> move line or selection\\n- < / > [V] -> reindent and keep selection",
      "autoResize": true
    },
    {
      "type": "rectangle",
      "id": "window_box",
      "x": 680,
      "y": 190,
      "width": 560,
      "height": 520,
      "roundness": { "type": 3 },
