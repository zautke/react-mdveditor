    },
    {
      "type": "text",
      "id": "snacks_text",
      "x": 1304,
      "y": 212,
      "width": 612,
      "height": 476,
      "text": "Picker / Explorer / UI Surface\\n\\nSnacks.nvim\\n- ␠ff files | ␠fG git files | ␠fr recent\\n- ␠fg grep | ␠fw grep word [N/V] | ␠f/ buffer lines\\n- ␠fb buffers | ␠fh help | ␠fc command history | ␠fk keymaps\\n- ␠fd diagnostics | ␠fD buffer diagnostics\\n- ␠fs LSP symbols | ␠fS workspace symbols\\n- ␠e explorer\\n- ␠gg lazygit | ␠gl lazygit log | ␠gs git status\\n- ⌃/ toggle terminal | ␠. terminal here\\n- ␠un dismiss notifications\\n- ]] / [[ next / prev reference\\n\\nOil.nvim\\n- - -> open parent directory\\n\\nTodo-comments.nvim\\n- ␠ft -> TODO quickfix\\n\\nSolarized.nvim\\n- ␠tb -> toggle light / dark\\n\\nAlways-on UI / support\\n- lualine.nvim | blink.cmp | fidget.nvim | nvim-web-devicons",
      "fontSize": 18,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "snacks_box",
      "originalText": "Picker / Explorer / UI Surface\\n\\nSnacks.nvim\\n- ␠ff files | ␠fG git files | ␠fr recent\\n- ␠fg grep | ␠fw grep word [N/V] | ␠f/ buffer lines\\n- ␠fb buffers | ␠fh help | ␠fc command history | ␠fk keymaps\\n- ␠fd diagnostics | ␠fD buffer diagnostics\\n- ␠fs LSP symbols | ␠fS workspace symbols\\n- ␠e explorer\\n- ␠gg lazygit | ␠gl lazygit log | ␠gs git status\\n- ⌃/ toggle terminal | ␠. terminal here\\n- ␠un dismiss notifications\\n- ]] / [[ next / prev reference\\n\\nOil.nvim\\n- - -> open parent directory\\n\\nTodo-comments.nvim\\n- ␠ft -> TODO quickfix\\n\\nSolarized.nvim\\n- ␠tb -> toggle light / dark\\n\\nAlways-on UI / support\\n- lualine.nvim | blink.cmp | fidget.nvim | nvim-web-devicons",
      "autoResize": true
    },
    {
      "type": "rectangle",
