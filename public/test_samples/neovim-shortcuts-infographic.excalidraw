    {
      "type": "text",
      "id": "ide_text",
      "x": 824,
      "y": 782,
      "width": 512,
      "height": 496,
      "text": "Tests / Run / Debug / Diagnostics\\n\\nTrouble.nvim\\n- ␠xx diagnostics\\n- ␠xX buffer diagnostics\\n- ␠xs symbols\\n- ␠xq quickfix\\n- ␠xl location list\\n\\nOverseer.nvim\\n- ␠rr run task\\n- ␠ro toggle task list\\n- ␠ra quick action\\n\\nNeotest\\n- ␠tt nearest test\\n- ␠tf file tests\\n- ␠tl last test\\n- ␠ts summary\\n- ␠to output panel\\n\\nDAP / DAP UI\\n- ␠dc continue\\n- ␠db toggle breakpoint\\n- ␠di step into\\n- ␠do step over\\n- ␠dO step out\\n- ␠du toggle DAP UI\\n\\nRelated background plugins\\n- nvim-dap-ui | mason-nvim-dap.nvim | nvim-nio",
      "fontSize": 18,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "ide_box",
      "originalText": "Tests / Run / Debug / Diagnostics\\n\\nTrouble.nvim\\n- ␠xx diagnostics\\n- ␠xX buffer diagnostics\\n- ␠xs symbols\\n- ␠xq quickfix\\n- ␠xl location list\\n\\nOverseer.nvim\\n- ␠rr run task\\n- ␠ro toggle task list\\n- ␠ra quick action\\n\\nNeotest\\n- ␠tt nearest test\\n- ␠tf file tests\\n- ␠tl last test\\n- ␠ts summary\\n- ␠to output panel\\n\\nDAP / DAP UI\\n- ␠dc continue\\n- ␠db toggle breakpoint\\n- ␠di step into\\n- ␠do step over\\n- ␠dO step out\\n- ␠du toggle DAP UI\\n\\nRelated background plugins\\n- nvim-dap-ui | mason-nvim-dap.nvim | nvim-nio",
