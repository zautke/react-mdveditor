MDE_HOST=adagio.local
MDE_APP_PORT=5200
MDE_DEV_PORT=5250
MDE_URL_SIDECAR_PORT=5280
MDE_SIDECAR_INTERNAL_PORT=5280
MDE_DB_SIDECAR_PORT=15280
MDE_DB_SIDECAR_INTERNAL_PORT=15280
MDE_DB_PROXY_ORIGIN=http://127.0.0.1:15280
# Persistence: ONE shared source for prod and dev. MDE_DB_DIR is a DIRECTORY,
# never the .db file — binding the file alone strands the SQLite rollback journal
# and every backup snapshot in the container's disposable writable layer.
MDE_DB_DIR=C:/Users/me/AppData/Local/mdeditor/data
MDE_DB_FILENAME=mdeditor.db
MDE_DB_BACKUP_SUBDIR=backups
MDE_DB_BACKUP_MAX=10
MDE_DB_BACKUP_INTERVAL_MS=21600000
MDE_RUNTIME_HOST=adagio
MDE_DB_HEALTH_TIMEOUT_MS=3000
MDE_ADAGIO_SSH_HOST=adagio
MDE_ADAGIO_DB_PATH=C:/Users/me/AppData/Local/mdeditor/data/mdeditor.db
MDE_PNPM_COMMAND=C:/nvm4w/nodejs/pnpm.cmd
MDE_APP_ORIGIN=http://adagio.local:5200
MDE_DEV_ORIGIN=https://adagio.local:5250
# Dev HTTPS. MDE_DEV_TLS_CERT_PATH/_KEY_PATH are the HOST-side paths used by
# `pnpm dev`; the dev container bind-mounts MDE_DEV_TLS_DIR at
# /certs and composes its own paths from the *_FILE names.
MDE_DEV_HTTPS=true
MDE_DEV_TLS_DIR=C:/Users/me/AppData/Local/mdeditor/dev-https
MDE_DEV_TLS_CERT_FILE=server.crt
MDE_DEV_TLS_KEY_FILE=server.key
MDE_DEV_TLS_CERT_PATH=C:/Users/me/AppData/Local/mdeditor/dev-https/server.crt
MDE_DEV_TLS_KEY_PATH=C:/Users/me/AppData/Local/mdeditor/dev-https/server.key
VITE_MDE_APP_ORIGIN=http://adagio.local:5200
VITE_MDE_EXTRACT_PATH=/api/extract

# Candidate origins the mde CLI (open_in_mde / mdeo) probes, in order, to find a
# running MDE before sending files. It sends to the FIRST origin that answers the
# /api/ping heartbeat; if none answer, it cold-starts a local dev server.
# Comma-separated full origins (scheme + host + port). Local-only by default —
# adagio.local is omitted while its network path is unreliable.
MDE_CANDIDATE_ORIGINS=http://127.0.0.1:5200,https://127.0.0.1:5250
