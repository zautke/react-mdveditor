{
  "name": "mdeditor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A React-based markdown editor with live preview and syntax highlighting",
  "bin": {
    "mde": "bin/mde.mjs"
  },
  "scripts": {
    "dev": "node scripts/adagio-dev.mjs",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "test:sidecar": "node --test --experimental-strip-types db-sidecar/server.test.mjs scripts/sidecar-health.test.mjs scripts/adagio-dev.test.mjs scripts/migrate-adagio-db.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@braisenly/design-tokens": "^0.3.2",
    "@braisenly/ui": "workspace:*",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hpcc-js/wasm-graphviz": "^1.21.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.12.2",
    "motion": "^12.23.26",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-feather": "^2.0.10",
    "react-markdown": "^10.1.0",
    "react-runner": "^1.0.5",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-mathjax": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.2.7"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=10.28.0"
  }
}
